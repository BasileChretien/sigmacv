{
  "name": "sigmacv",
  "version": "0.3.0",
  "private": true,
  "description": "Auto-generate clean, customizable academic CVs from open research data (OpenAlex, ORCID).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-db.mjs && node scripts/ensure-playwright.mjs",
    "dev": "next dev",
    "predev:public": "node scripts/ensure-db.mjs && node scripts/ensure-playwright.mjs",
    "dev:public": "next dev -H ::",
    "db:sync": "node scripts/ensure-db.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "deadcode": "npx --yes knip@6 --no-progress",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@4 --output-format JSON --output-file sbom.cdx.json --omit dev --mc-type application",
    "gen:schema": "tsx scripts/gen-cv-schema.ts",
    "fetch-csl": "node scripts/fetch-csl.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "resync": "node scripts/resync.mjs",
    "research:export": "dotenv -e .env -- tsx scripts/export-research-data.ts",
    "oep:import": "dotenv -e .env -- tsx scripts/oep-import.ts",
    "ictrp:import": "dotenv -e .env -- tsx scripts/ictrp-import.ts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:push:e2e": "dotenv -e .env.e2e -- prisma db push",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "postinstall": "prisma generate",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,css,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "nodemailer": "^9.1.1",
    "@hono/node-server": "^1.19.14",
    "mysql2": "^3.24.3",
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "^3.1.7"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "astrocite-bibtex": "^0.16.4",
    "citeproc": "^2.4.63",
    "docx": "^9.0.0",
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.1",
    "motion": "^13.1.1",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^9.1.1",
    "playwright": "1.62.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/engines": true
  }
}
